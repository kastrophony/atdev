# Copy to .env and fill in every blank value. Generate secrets, e.g.:
#   openssl rand -hex 32     (JWT secret, rotation key, admin secrets)
#   openssl rand -hex 24     (passwords)

# Public domain suffix. Services are exposed as <service>.<DOMAIN>.
DOMAIN=example.com

# Caddy (only publicly exposed service; maps to the host proxy port)
DEPLOY_CADDY=1
CADDY_PORT=8000

# PDS
DEPLOY_PDS=1
PDS_ADMIN_PASSWORD=
PDS_JWT_SECRET=
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=

# PLC
DEPLOY_PLC=1
PLC_ADMIN_SECRET=
PLC_POSTGRES_PASSWORD=

# Jetstream
DEPLOY_JETSTREAM=1

# Constellation
DEPLOY_CONSTELLATION=1

# Relay
DEPLOY_RELAY=1
RELAY_ADMIN_PASSWORD=
RELAY_POSTGRES_PASSWORD=
RELAY_TRUSTED_DOMAINS=
