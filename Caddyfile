{
	auto_https off
}

:8000 {
	log {
		output stdout
		format console
	}

	# PLC directory
	@plc host plc.{$DOMAIN}
	handle @plc {
		reverse_proxy plc:{$PLC_PORT}
	}

	# Jetstream
	@jetstream host jetstream.{$DOMAIN}
	handle @jetstream {
		reverse_proxy jetstream:{$JETSTREAM_PORT}
	}

	# Relay
	@relay host relay.{$DOMAIN}
	handle @relay {
		reverse_proxy relay:{$RELAY_PORT}
	}

	# Spaces PDS
	@spaces_pds host space.{$DOMAIN}
	handle @spaces_pds {
		reverse_proxy spaces_pds:{$SPACES_PDS_PORT}
	}

	# Everything else -> PDS (covers pds.<DOMAIN> and the host proxy hostname)
	handle {
		reverse_proxy pds:{$PDS_PORT}
	}
}
